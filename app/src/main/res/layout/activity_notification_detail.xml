<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/surface" app:titleCentered="true"
        />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="10dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/surface"
                >
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tv_app" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/primary_dark" />
                    <TextView android:id="@+id/tv_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/tv_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/text_primary" android:textIsSelectable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/detail_result" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="18dp" />
            <TextView android:id="@+id/tv_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/text_primary" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/detail_ai_score" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="18dp" />
            <ProgressBar android:id="@+id/progress_score" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="100" />
            <TextView android:id="@+id/tv_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginTop="4dp" />

            <TextView android:id="@+id/tv_recalled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/recalled_notice" android:textSize="12sp" android:textColor="@color/accent" android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp">
                <Button android:id="@+id/btn_spam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mark_spam" android:textSize="12sp" />
                <Button android:id="@+id/btn_normal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mark_normal" android:textSize="12sp" android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <Button android:id="@+id/btn_restore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/restore_notification" android:textSize="12sp" />
                <Button android:id="@+id/btn_delete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/delete_record" android:textSize="12sp" android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
